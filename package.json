{
    "name": "edu-lanka-monorepo",
    "version": "0.0.1",
    "private": true,
    "description": "EduLanka — National-scale multi-tenant educational SaaS platform for Sri Lanka",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "postinstall": "turbo run build --filter=@edu-lanka/shared-types",
        "dev": "turbo run dev --parallel",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:e2e": "turbo run test:e2e",
        "test:load": "docker run --rm -i -v $(pwd)/infrastructure/tests:/tests --network docker_edu-network -e BASE_URL=http://edu-nginx/api/v1 -e SUPER_ADMIN_PASSWORD=SuperAdmin@edu! grafana/k6 run /tests/full-system.js",
        "clean": "turbo run clean && rm -rf node_modules",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
    },
    "devDependencies": {
        "@edu-lanka/config": "workspace:*",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.10",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "turbo": "^2.1.3",
        "typescript": "^5.5.4"
    },
    "packageManager": "pnpm@9.9.0",
    "dependencies": {
        "jsonwebtoken": "^9.0.3"
    },
    "pnpm": {
        "auditConfig": {
            "ignoreGhsas": [
                "GHSA-vfj7-8cjw-p6xm",
                "GHSA-hp3w-g68c-fv3c"
            ]
        },
        "overrides": {
            "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
            "axios@<1.20.0": ">=1.20.0",
            "brace-expansion@<1.1.21": ">=1.1.21 <2.0.0",
            "brace-expansion@>=2.0.0 <2.1.7": ">=2.1.7 <3.0.0",
            "brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12 <6.0.0",
            "engine.io@<6.6.10": ">=6.6.10",
            "fastify": "5.12.5",
            "fast-uri@<3.1.8": ">=3.1.8",
            "@fastify/middie@<9.3.2": ">=9.3.2",
            "file-type@<21.3.2": ">=21.3.2",
            "find-my-way@<9.7.0": ">=9.7.0",
            "glob@>=10.2.0 <10.5.0": ">=10.5.0",
            "js-yaml@<5.4.0": ">=5.4.1",
            "lodash@<=4.17.23": ">=4.18.0",
            "nanoid@<3.3.18": ">=3.3.18",
            "@nestjs/core@<=11.1.17": ">=11.1.18 <12.0.0",
            "@nestjs/platform-fastify@<11.2.4": ">=11.2.4 <12.0.0",
            "picomatch@<4.0.4": ">=4.0.4",
            "proxy-addr@<2.0.8": ">=2.0.8",
            "qs@<6.16.0": ">=6.16.0",
            "sharp@<0.35.4": ">=0.35.4",
            "source-map-js@<1.2.2": ">=1.2.2",
            "tmp@<0.2.6": ">=0.2.6",
            "webpack@<5.104.1": ">=5.104.1"
        }
    }
}