{
    "name": "edu-lanka-monorepo",
    "version": "0.0.1",
    "private": true,
    "description": "EduLanka — National-scale multi-tenant educational SaaS platform for Sri Lanka",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "postinstall": "turbo run build --filter=@edu-lanka/shared-types",
        "dev": "turbo run dev --parallel",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "lint:fix": "turbo run lint:fix",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:e2e": "turbo run test:e2e",
        "test:load": "docker run --rm -i -v $(pwd)/infrastructure/tests:/tests --network docker_edu-network -e BASE_URL=http://edu-nginx/api/v1 -e SUPER_ADMIN_PASSWORD=SuperAdmin@edu! grafana/k6 run /tests/full-system.js",
        "clean": "turbo run clean && rm -rf node_modules",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
    },
    "devDependencies": {
        "@edu-lanka/config": "workspace:*",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.10",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "turbo": "^2.1.3",
        "typescript": "^5.5.4"
    },
    "packageManager": "pnpm@9.9.0",
    "dependencies": {
        "jsonwebtoken": "^9.0.3"
    }
}