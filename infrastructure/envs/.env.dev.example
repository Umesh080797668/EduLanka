# ─────────────────────────────────────────────────────────────
# EduLanka — Dev Environment Template
# Copy to apps/api/.env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
APP_PUBLIC_URL=http://localhost:3000
SYSTEM_TENANT_ID=91c85e7c-7907-4915-ae70-4d5b7f3a843c
DEPLOY_TIMESTAMP=

# ── Supabase (cloud or local) ─────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-32-plus-character-secret-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# ── Twilio (SMS Auth & Notifications) ─────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_FROM_NUMBER=your_twilio_from_number
TWILIO_SENDER_ID=your_twilio_sender_id
TWILIO_WEBHOOK_URL=http://localhost:8081/api/v1/sms/webhook

# ── Mobile Offline License ────────────────────────────────────
OFFLINE_LICENSE_KEY_ID=edulanka-offline-v1
OFFLINE_LICENSE_PRIVATE_KEY=

# ── Firebase Cloud Messaging ──────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Seed & Test Variables ─────────────────────────────────────
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-strong-initial-password
GATEWAY_URL=http://localhost:8081
TARGET_FCM_TOKEN=
