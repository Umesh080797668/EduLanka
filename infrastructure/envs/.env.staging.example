# ─────────────────────────────────────────────────────────────
# EduLanka — Staging environment template
# All secrets must be injected via CI secrets, not stored here.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${STAGING_POSTGRES_PASSWORD}
POSTGRES_DB=edu_lanka_staging

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=edu-redis
REDIS_PORT=6379
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=${STAGING_SUPABASE_URL}
SUPABASE_SERVICE_ROLE_KEY=${STAGING_SUPABASE_SERVICE_ROLE_KEY}
NEXT_PUBLIC_SUPABASE_URL=${STAGING_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${STAGING_SUPABASE_ANON_KEY}

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────
NODE_ENV=staging
PORT=3001
ALLOWED_ORIGINS=${STAGING_APP_URL}
NEXT_PUBLIC_API_URL=${STAGING_API_URL}
NEXT_PUBLIC_APP_URL=${STAGING_APP_URL}
