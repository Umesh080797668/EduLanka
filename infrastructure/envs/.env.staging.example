# ─────────────────────────────────────────────────────────────
# EduLanka — Staging Environment Template
# All secrets must be injected via CI secrets, not stored here.
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=staging
PORT=3001
ALLOWED_ORIGINS=${STAGING_APP_URL}
APP_PUBLIC_URL=${STAGING_APP_URL}
SYSTEM_TENANT_ID=91c85e7c-7907-4915-ae70-4d5b7f3a843c
DEPLOY_TIMESTAMP=${STAGING_DEPLOY_TIMESTAMP}
NEXT_PUBLIC_API_URL=${STAGING_API_URL}
NEXT_PUBLIC_APP_URL=${STAGING_APP_URL}
API_URL=${STAGING_API_URL}

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=${STAGING_SUPABASE_URL}
SUPABASE_ANON_KEY=${STAGING_SUPABASE_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${STAGING_SUPABASE_SERVICE_ROLE_KEY}
NEXT_PUBLIC_SUPABASE_URL=${STAGING_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${STAGING_SUPABASE_ANON_KEY}

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=edu-redis
REDIS_PORT=6379
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
REDIS_URL=${STAGING_REDIS_URL}
UPSTASH_REDIS_REST_URL=${STAGING_UPSTASH_REDIS_REST_URL}
UPSTASH_REDIS_REST_TOKEN=${STAGING_UPSTASH_REDIS_REST_TOKEN}

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=${STAGING_JWT_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_API_KEY=${STAGING_CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${STAGING_CLOUDINARY_API_SECRET}
CLOUDINARY_UPLOAD_PRESET=${STAGING_CLOUDINARY_UPLOAD_PRESET}
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=${STAGING_CLOUDINARY_CLOUD_NAME}

# ── Twilio ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=${STAGING_TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${STAGING_TWILIO_AUTH_TOKEN}
TWILIO_FROM_NUMBER=${STAGING_TWILIO_FROM_NUMBER}
TWILIO_SENDER_ID=${STAGING_TWILIO_SENDER_ID}
TWILIO_WEBHOOK_URL=${STAGING_TWILIO_WEBHOOK_URL}

# ── Mobile Offline License (Ed25519) ──────────────────────────
OFFLINE_LICENSE_KEY_ID=edulanka-offline-v1
OFFLINE_LICENSE_PRIVATE_KEY=${STAGING_OFFLINE_LICENSE_PRIVATE_KEY}

# ── Firebase Cloud Messaging ──────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=${STAGING_FIREBASE_SERVICE_ACCOUNT}
GOOGLE_APPLICATION_CREDENTIALS=${STAGING_GOOGLE_APPLICATION_CREDENTIALS}

# ── Seed & Test Variables ─────────────────────────────────────
INITIAL_SUPER_ADMIN_PASSWORD=${STAGING_INITIAL_SUPER_ADMIN_PASSWORD}
GATEWAY_URL=${STAGING_GATEWAY_URL}
TARGET_FCM_TOKEN=${STAGING_TARGET_FCM_TOKEN}
