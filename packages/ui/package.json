{
    "name": "@edu-lanka/ui",
    "version": "0.0.1",
    "private": true,
    "description": "Shared React UI component primitives for EduLanka web dashboards",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "typecheck": "tsc --noEmit",
        "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts,.tsx",
        "clean": "rm -rf dist *.tsbuildinfo",
        "test": "jest"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@edu-lanka/config": "workspace:*",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/jest": "^29.5.14",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.4.1",
        "ts-jest": "^29.2.4",
        "typescript": "^5.5.4"
    }
}