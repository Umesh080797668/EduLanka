{
    "name": "@edu-lanka/shared-types",
    "version": "0.0.1",
    "private": true,
    "description": "Shared TypeScript interfaces, DTOs, and enums for the EduLanka platform",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist *.tsbuildinfo",
        "test": "jest"
    },
    "devDependencies": {
        "@edu-lanka/config": "workspace:*",
        "@types/jest": "^29.5.14",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.4",
        "typescript": "^5.5.4"
    }
}