# ─────────────────────────────────────────────────────────────
# EduLanka — Analytics Microservice Environment Variables (EXAMPLE)
# Copy this file to apps/analytics/.env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Service Configuration ─────────────────────────────────────
PORT=8083
NODE_ENV=development

# ── Database Connections (PostgreSQL URI format: postgresql://[user]:[password]@[host]:[port]/[db]) ─
# NOTE: Do NOT use HTTPS URLs (e.g. https://<project>.supabase.co). The pg driver requires postgresql:// URI.
#
# Supabase Cloud Format:
# ANALYTICS_DATABASE_URL=postgresql://analytics_ro:replace-with-ro-password@db.<project-ref>.supabase.co:5432/postgres
# WRITE_DATABASE_URL=postgresql://postgres:replace-with-write-password@db.<project-ref>.supabase.co:5432/postgres
#
# Local / Self-Hosted Format:
ANALYTICS_DATABASE_URL=postgresql://analytics_ro:replace-with-ro-password@localhost:5432/postgres?schema=public
WRITE_DATABASE_URL=postgresql://postgres:replace-with-write-password@localhost:5432/postgres?schema=public
SUPABASE_DB_URL=postgresql://postgres:replace-with-write-password@localhost:5432/postgres?schema=public

# ── JWT Authentication ───────────────────────────────────────
# Shared with apps/api so Super Admin tokens issued by auth service can be verified
JWT_SECRET=replace-with-a-32-plus-character-secret-string
