{
    "name": "@edu-lanka/api",
    "version": "0.0.1",
    "private": true,
    "description": "EduLanka — NestJS REST API (Core School Service)",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main",
        "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts --fix",
        "lint:check": "ESLINT_USE_FLAT_CONFIG=false eslint src --ext .ts",
        "typecheck": "tsc --noEmit",
        "test": "jest --passWithNoTests --maxWorkers=4",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage --passWithNoTests --maxWorkers=4",
        "test:e2e": "jest --testRegex='.*\\.e2e-spec\\.ts$' --testEnvironment=node --passWithNoTests",
        "seed:staging": "ts-node -r tsconfig-paths/register scripts/seed-staging.ts",
        "seed:admin": "ts-node -r tsconfig-paths/register scripts/seed-admin.ts",
        "clean": "rm -rf dist *.tsbuildinfo",
        "cleanup:test-data": "npx supabase db reset --linked"
    },
    "dependencies": {
        "@edu-lanka/shared-types": "workspace:*",
        "@fastify/compress": "^8.3.1",
        "@fastify/formbody": "^8.0.2",
        "@fastify/helmet": "^13.1.1",
        "@fastify/static": "^10.1.2",
        "@nest-lab/throttler-storage-redis": "^1.2.0",
        "@nestjs/bullmq": "^11.0.5",
        "@nestjs/common": "^11.2.7",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.7",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-fastify": "^11.2.7",
        "@nestjs/platform-socket.io": "^11.2.7",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/websockets": "^11.2.7",
        "@socket.io/redis-adapter": "^8.3.0",
        "@supabase/supabase-js": "^2.45.3",
        "@types/pg": "^8.21.0",
        "bullmq": "^6.1.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cloudinary": "^2.10.0",
        "fastify": "5.12.5",
        "firebase-admin": "^14.5.0",
        "ioredis": "^5.4.1",
        "joi": "^17.13.6",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdfkit": "^0.19.1",
        "pg": "^8.23.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.3",
        "twilio": "^6.1.0"
    },
    "devDependencies": {
        "@edu-lanka/config": "workspace:*",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.7",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.5.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/pdfkit": "^0.17.6",
        "@types/supertest": "^7.2.1",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "dotenv": "^17.4.2",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.2.4",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.4"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "tsconfig": "./tsconfig.spec.json"
                }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageThreshold": {
            "global": {
                "branches": 60,
                "functions": 60,
                "lines": 60,
                "statements": 60
            }
        },
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}