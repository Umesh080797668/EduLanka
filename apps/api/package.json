{
    "name": "@edu-lanka/api",
    "version": "0.0.1",
    "private": true,
    "description": "EduLanka — NestJS REST API (Core School Service)",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main",
        "lint": "eslint src --ext .ts --fix",
        "lint:check": "eslint src --ext .ts",
        "typecheck": "tsc --noEmit",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage --passWithNoTests",
        "test:e2e": "jest --testPathPattern='__tests__/.*\\.e2e-spec\\.ts$' --testEnvironment=node --passWithNoTests",
        "migrate:tenants": "ts-node -r tsconfig-paths/register scripts/migrate-all-tenants.ts",
        "clean": "rm -rf dist *.tsbuildinfo"
    },
    "dependencies": {
        "@edu-lanka/shared-types": "workspace:*",
        "@fastify/helmet": "^11.1.1",
        "@fastify/static": "^7.0.4",
        "@nestjs/common": "^10.3.10",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.3.10",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-fastify": "^10.3.10",
        "@nestjs/swagger": "^7.4.0",
        "@nestjs/terminus": "^10.2.3",
        "@supabase/supabase-js": "^2.45.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "fastify": "4.28.1",
        "ioredis": "^5.4.1",
        "joi": "^17.13.3",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@edu-lanka/config": "workspace:*",
        "@nestjs/cli": "^10.4.5",
        "@nestjs/schematics": "^10.1.4",
        "@nestjs/testing": "^10.3.10",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.5.0",
        "@types/passport-jwt": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "dotenv": "^17.4.2",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.2.4",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.4"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "tsconfig": "./tsconfig.spec.json"
                }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}