{
    "extends": "../../packages/config/tsconfig.nestjs.json",
    "compilerOptions": {
        "baseUrl": "./",
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "@app/*": [
                "src/*"
            ],
            "@config/*": [
                "src/config/*"
            ],
            "@common/*": [
                "src/common/*"
            ],
            "@modules/*": [
                "src/modules/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test",
        "**/*spec.ts"
    ]
}