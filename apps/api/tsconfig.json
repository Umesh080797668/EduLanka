{
    "extends": "../../packages/config/tsconfig.nestjs.json",
    "compilerOptions": {
        "baseUrl": "./",
        "rootDir": "./",
        "outDir": "./dist",
        "types": [
            "node",
            "jest"
        ],
        "paths": {
            "@app/*": [
                "src/*"
            ],
            "@config/*": [
                "src/config/*"
            ],
            "@common/*": [
                "src/common/*"
            ],
            "@modules/*": [
                "src/modules/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "scripts/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}