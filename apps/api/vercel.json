{
    "version": 2,
    "buildCommand": "npx turbo run build --filter=@edu-lanka/api...",
    "builds": [
        {
            "src": "src/main.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/main.ts"
        }
    ]
}