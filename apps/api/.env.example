# ─────────────────────────────────────────────────────────────
# EduLanka — NestJS API Environment Variables (EXAMPLE)
# Copy this file to apps/api/.env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application Configuration ────────────────────────────────
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
APP_PUBLIC_URL=http://localhost:3000
SYSTEM_TENANT_ID=91c85e7c-7907-4915-ae70-4d5b7f3a843c
DEPLOY_TIMESTAMP=

# ── Supabase (Database & Realtime) ───────────────────────────
# Obtain from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# ── Redis (Cache, Sessions & Rate Limiting) ──────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── JWT Authentication ───────────────────────────────────────
# Min 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-32-plus-character-secret-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary Media Storage ─────────────────────────────────
# Used for direct uploads, video streaming, and attachments
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=replace-with-cloudinary-upload-preset

# ── Twilio (SMS & Emergency Notifications) ────────────────────
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-from-phone-number
TWILIO_SENDER_ID=replace-with-twilio-sender-id
TWILIO_WEBHOOK_URL=http://localhost:8081/api/v1/sms/webhook

# ── Mobile Offline License Signing (Ed25519) ──────────────────
# Required in production and staging environments
OFFLINE_LICENSE_KEY_ID=edulanka-offline-v1
OFFLINE_LICENSE_PRIVATE_KEY=replace-with-base64-or-pem-ed25519-private-key

# ── Firebase Cloud Messaging (FCM Push Notifications) ────────
# Raw JSON string or Base64-encoded service account key
FIREBASE_SERVICE_ACCOUNT=replace-with-firebase-service-account-json
GOOGLE_APPLICATION_CREDENTIALS=

# ── Seed & Test Variables ─────────────────────────────────────
INITIAL_SUPER_ADMIN_PASSWORD=replace-with-strong-initial-password
GATEWAY_URL=http://localhost:8081
TARGET_FCM_TOKEN=replace-with-test-target-fcm-token
