# ─────────────────────────────────────────────────────────────
# EduLanka — Next.js Web App environment variables (EXAMPLE)
# Copy to apps/web/.env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Full URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NestJS API base URL — routed through Nginx gateway on port 8081
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# ── Supabase (browser-safe) ───────────────────────────────────
# Get these from your Supabase project dashboard:
# Settings → API → URL / Anon (public) key
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
